# Copy to .env and fill in. `epiphany check` says what is missing and whether the store and the
# database answer (it makes no OpenAI call). All values here are demo values.

# WooCommerce: REST API keys with read/write permission (WooCommerce > Settings > Advanced > REST API)
WOOCOMMERCE_URL=https://shop.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_demo_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_demo_replace_me
WOOCOMMERCE_VERIFY_SSL=true          # false only for a store with a self-signed certificate
REQUEST_TIMEOUT=60
REQUEST_ATTEMPTS=5

# PostgreSQL: which products were updated or failed, the generated text, the saved originals
DATABASE_URL=postgresql://epiphany:demo-password@localhost:5432/epiphany

# OpenAI
OPENAI_API_KEY=sk-demo-replace-me
OPENAI_MODEL=demo-model-name         # a chat model your account can use; no default on purpose
OPENAI_TIMEOUT=120
GENERATION_ATTEMPTS=2                # asks again when the answer is not the JSON that was requested

# Behaviour
CONCURRENCY=5                        # products processed at once
RENAME_TO_SEO_TITLE=true             # false keeps the product name; the Yoast title is still set
LOG_LEVEL=INFO
LOG_FILE=
